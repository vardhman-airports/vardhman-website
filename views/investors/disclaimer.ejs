        </div>

        <label class="vas-disc-check">
            <input type="checkbox" id="vasDiscChk1">
            <span>I hereby declare that I am a resident of India, and there are no restrictions on my accessing or receiving the information contained on this website.</span>
        </label>
        <label class="vas-disc-check">
            <input type="checkbox" id="vasDiscChk2">
            <span>I have read the Legal Disclaimer and am entitled to receive information contained in this website.</span>
        </label>

        <div class="vas-disc-actions">
            <button type="button" id="vasDiscConfirm" class="vas-disc-btn vas-disc-confirm" disabled>Confirm and Proceed</button>
            <button type="button" id="vasDiscDeny" class="vas-disc-btn vas-disc-deny">Do Not Confirm</button>
        </div>
    </div>
</div>

<script>
    (function () {
        var KEY = 'vasInvestorDisclaimerAccepted';
        var overlay = document.getElementById('vasDisclaimerOverlay');
        if (!overlay) return;

        // Already acknowledged in this browser session — don't gate again.
        if (sessionStorage.getItem(KEY) === 'yes') {
            overlay.classList.remove('is-open');
            return;
        }
        document.body.classList.add('vas-disc-lock');

        var chk1 = document.getElementById('vasDiscChk1');
        var chk2 = document.getElementById('vasDiscChk2');
        var confirmBtn = document.getElementById('vasDiscConfirm');
        var denyBtn = document.getElementById('vasDiscDeny');

        function sync() { confirmBtn.disabled = !(chk1.checked && chk2.checked); }
        chk1.addEventListener('change', sync);
        chk2.addEventListener('change', sync);

        confirmBtn.addEventListener('click', function () {
            if (chk1.checked && chk2.checked) {
                sessionStorage.setItem(KEY, 'yes');
                overlay.classList.remove('is-open');
                document.body.classList.remove('vas-disc-lock');
            }
        });

        denyBtn.addEventListener('click', function () {
            window.location.href = '/';
        });
    })();
</script>
