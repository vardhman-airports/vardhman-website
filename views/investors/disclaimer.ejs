    }
    .vas-disc-overlay.is-open { display: flex; }
    body.vas-disc-lock { overflow: hidden; }
    .vas-disc-modal {
        background: #fff;
        width: 100%;
        max-width: 960px;
        max-height: 90vh;
        border-radius: 10px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        padding: 1.75rem 2rem 2rem;
        display: flex;
        flex-direction: column;
    }
    .vas-disc-title {
        color: #0b1f4d;
        font-size: 1.7rem;
        font-weight: 800;
        margin: 0 0 1rem;
    }
    .vas-disc-scroll {
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 1.25rem 1.5rem;
        overflow-y: auto;
        flex: 1 1 auto;
        min-height: 0;
    }
    .vas-disc-scroll p { margin: 0 0 1rem; color: #374151; font-size: 0.95rem; line-height: 1.65; }
    .vas-disc-scroll p:last-child { margin-bottom: 0; }
    .vas-disc-intro { color: #0b1f4d !important; font-weight: 700 !important; text-transform: uppercase; }
    .vas-disc-important {
        background: #fdecec;
        color: #b91c1c !important;
        font-weight: 600 !important;
        padding: 0.75rem 1rem;
        border-radius: 6px;
    }
    .vas-disc-check {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.9rem;
        color: #374151;
        line-height: 1.5;
        margin: 1rem 0 0;
        cursor: pointer;
    }
    .vas-disc-check input { margin-top: 0.2rem; flex: 0 0 auto; width: 1rem; height: 1rem; cursor: pointer; }
    .vas-disc-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
    .vas-disc-btn {
        padding: 0.85rem 1.75rem;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.15s ease, opacity 0.15s ease;
    }
    .vas-disc-confirm { background: #16a34a; color: #fff; }
    .vas-disc-confirm:hover:not(:disabled) { background: #15803d; }
    .vas-disc-confirm:disabled { background: #9ca3af; cursor: not-allowed; opacity: 0.8; }
    .vas-disc-deny { background: #d1d5db; color: #374151; }
    .vas-disc-deny:hover { background: #c3c8cf; }
    @media (max-width: 600px) {
        .vas-disc-modal { padding: 1.25rem 1.1rem 1.5rem; }
        .vas-disc-title { font-size: 1.4rem; }
        .vas-disc-btn { flex: 1 1 100%; }
    }
</style>

