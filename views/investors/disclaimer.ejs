<!-- Investor Disclaimer Gate (SEBI ICDR) — shown on all public investor pages -->
<style>
    .vas-disc-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        z-index: 100000;
