<%- include('../../partials/header') %>
    <br><br><br><br><br>

    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .cat-section { margin-bottom: 2.5rem; }
        .cat-section h3 { font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #1e293b; border-left: 4px solid #2563eb; padding-left: 0.75rem; margin-bottom: 0.75rem; }
        .type-badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 600; background: #dbeafe; color: #1d4ed8; }
        .posts-table table th:last-child,
        .posts-table table td:last-child { width: 1%; white-space: nowrap; text-align: right; }
    </style>

    <div class="admin-container">
        <div class="admin-header">
            <h1>Investors Admin Dashboard</h1>
            <div class="admin-actions">
                <a href="/investors/admin/add" class="btn-primary">Add Document</a>
                <form method="POST" action="/investors/admin/logout" style="display: inline;">
                    <button type="submit" class="btn-secondary">Logout</button>
                </form>
            </div>
        </div>

        <div class="admin-content">
            <% const categories = Object.keys(grouped); %>
            <% if (categories.length === 0) { %>
                <p>No documents yet. <a href="/investors/admin/add">Add the first one.</a></p>
            <% } else { %>
                <% categories.forEach(function(cat) { %>
                    <div class="cat-section">
                        <h3><%= grouped[cat].label %></h3>
                        <div class="posts-table">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Label</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% grouped[cat].docs.forEach(function(doc) { %>
                                        <tr>
                                            <td><%= doc.label %></td>
                                            <td>
                                                <a href="/investors/admin/edit/<%= doc.id %>" class="btn-secondary" style="margin-right: 0.4rem;">Edit / Replace</a>
                                                <form method="POST" action="/investors/admin/delete/<%= doc.id %>"
                                                    style="display: inline;"
                                                    onsubmit="return confirm('Delete this document?')">
                                                    <button type="submit" class="btn-delete">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <%- include('../../partials/footer') %>
