<%- include('../partials/header', { currentTitle: 'Group Companies' }) %>
<link rel="stylesheet" href="/css/investors.css">

<style>
    .gc-company { margin-bottom: 3.5rem; }
    .gc-company:last-child { margin-bottom: 0; }
    .gc-company-name {
        color: #1e293b;
        font-size: 1.9rem;
        font-weight: 700;
        margin: 0 0 1.5rem;
        font-family: "Playfair Display", Georgia, serif;
    }
    .gc-section {
        border: 1px solid #dbe4f0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1rem;
    }
    .gc-section-header {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1.1rem 1.5rem;
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.02em;
    }
    .gc-section-header i { font-size: 1.1rem; flex-shrink: 0; }
    .gc-section-body { padding: 0.5rem 1.5rem 1rem; }
    .gc-section-body .inv-docs-grid { gap: 0 3rem; }
    .gc-empty { color: #94a3b8; padding: 1rem 0; font-size: 0.95rem; }
</style>

<br><br>
<div class="top-br"><br><br></div>

<!-- Hero banner (matches site pages) -->
<section class="inv-doc-hero">
    <div class="inv-doc-hero-inner">
        <h1>Group Companies</h1>
    </div>
</section>

<section class="inv-docs-section">
    <div class="inv-docs-inner">
        <% companies.forEach(function(company) { %>
            <div class="gc-company">
                <h2 class="gc-company-name"><%= company.name %></h2>
                <% company.sections.forEach(function(section) { %>
                    <div class="gc-section">
                        <div class="gc-section-header"><i class="fas fa-file-invoice-dollar"></i><%= section.title %></div>
                        <div class="gc-section-body">
                            <% if (section.documents && section.documents.length > 0) { %>
                                <div class="inv-docs-grid">
                                    <% section.documents.forEach(function(doc) {
                                        var ext = doc.file.split('.').pop().toLowerCase();
                                        var icon = ext === 'xls' || ext === 'xlsx' ? 'fa-file-excel' :
                                                   ext === 'doc' || ext === 'docx' ? 'fa-file-word' : 'fa-file-pdf';
                                    %>
                                        <a href="<%= doc.file %>" class="inv-doc-row" target="_blank" rel="noopener noreferrer">
                                            <div class="inv-doc-circle"><i class="fas <%= icon %>"></i></div>
                                            <span class="inv-doc-name"><%= doc.label %></span>
                                        </a>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="gc-empty">Documents will be available here shortly.</p>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    </div>
</section>

<%- include('../partials/footer') %>
