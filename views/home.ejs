    <style>
    :root {
        --brand-cta: #133b5c; /* military blue accent (fallback) */
        --brand-cta-2: #2563eb; /* existing brand blue */
        --overlay-dark: rgba(0,0,0,0.6);
        --soft-glow: 0 8px 30px rgba(37,99,235,0.12);
        --ui-radius: 0.6rem;
    }

    /* container + right-side gradient overlay so text stays readable */
    .carousel-container {
        position: relative;
        width: 100%;
        height: 80vh;
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);
        overflow: hidden;
    }
    .carousel-container::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(40%, 420px);
        pointer-events: none;
        background: linear-gradient(90deg, var(--overlay-dark) 0%, rgba(0,0,0,0.35) 30%, rgba(0,0,0,0.08) 60%, transparent 100%);
        mix-blend-mode: multiply;
        transition: opacity 0.35s ease;
        z-index: 5;
    }

    .carousel-track { position: relative; width: 100%; height: 100%; overflow: hidden; }

    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: 30% 70%;
        opacity: 0;
        transform: translateX(60px);
        transition: all 1.2s cubic-bezier(0.23, 1, 0.32, 1);
        z-index: 1;
        pointer-events: none;
    }
    .carousel-slide.active {
        opacity: 1;
        transform: translateX(0);
        z-index: 10;
        pointer-events: auto;
    }

    /* Text block: serif headings, clean sans body/CTA, optional bottom-left layout */
    .slide-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 2rem 2rem 3rem;
        position: relative;
        z-index: 10;
        color: #fff;
        font-family: "Playfair Display", Georgia, serif;
        animation: fadeUp 600ms ease both;
        background: linear-gradient(180deg, rgba(10,10,10,0.60), rgba(10,10,10,0.30));
        backdrop-filter: blur(3px);
    }
    .slide-content::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(180deg, #0070f3 0%, #00d4ff 100%);
    }
    .slide-content.bottom-left {
        max-width: 48%;
        padding: 1.2rem;
        align-self: flex-end;
        text-align: left;
    }

    .slide-category {
        font-size: 0.8rem;
        font-weight: 500;
        color: #0070f3;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .slide-title {
        margin-top: 0;
        font-size: clamp(1.6rem, 4vw, 3rem);
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 1rem;
        line-height: 0.98;
        letter-spacing: -0.02em;
        font-family: "Playfair Display", Georgia, serif;
    }
    .slide-title h1 { margin-top: 0; }

    .slide-description {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.9);
        margin-bottom: 1.2rem;
        line-height: 1.6;
        font-family: "Inter", "Poppins", Arial, sans-serif;
        font-weight: 400;
        max-width: 42rem;
    }

    /* CTA: primary-colored, bolder, hover micro-interactions, full-width on mobile */
    .slide-cta {
        width: 90%;
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.25rem;
        background: var(--brand-cta);
        color: #fff;
        border-radius: var(--ui-radius);
        font-weight: 700;
        font-family: "Inter", "Poppins", Arial, sans-serif;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
        box-shadow: 0 6px 18px rgba(19,59,92,0.12);
        border: 1px solid rgba(255,255,255,0.04);
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        position: relative;
        overflow: hidden;
    }
    .slide-cta::before {
        content: '';
        position: absolute;
        inset: 0;
        left: -100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
        transition: left 0.8s ease;
        border-radius: inherit;
        pointer-events: none;
    }
    .slide-cta:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: var(--soft-glow);
        background: linear-gradient(180deg, var(--brand-cta), var(--brand-cta-2));
        color: #fff;
    }
    .slide-cta:hover::before { left: 100%; }

    /* slide image + subtle overlays + parallax-ready */
    .slide-image {
        position: relative;
        background: radial-gradient(circle at 30% 30%, rgba(0, 112, 243, 0.03) 0%, transparent 70%),
                    linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0;
        z-index: 2;
    }
    .slide-image::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background:
            radial-gradient(circle at 70% 70%, rgba(0, 212, 255, 0.03) 0%, transparent 50%),
            linear-gradient(45deg, transparent 0%, rgba(0, 112, 243, 0.02) 50%, transparent 100%);
        z-index: 1;
    }
    .slide-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: brightness(1.05) contrast(1.05) saturate(0.95);
        position: relative;
        transition: transform 0.8s ease;
        will-change: transform;
        z-index: 2;
    }
    .carousel-slide.active .slide-image img { transform: scale(1.02); }

    /* Navigation: vertical nav dots and circular prev/next controls */
    .carousel-nav {
        position: absolute;
        right: 80px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 16px;
        z-index: 100;
    }
    /* horizontal thumbnail-like nav placed under slides (alternative) */
    .carousel-nav.horizontal {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        bottom: 12px;
        display: flex;
        gap: 0.6rem;
    }

    .nav-dot {
        width: 8px;
        height: 40px;
        background: rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: all 0.4s ease;
        position: relative;
    }
    .nav-dot::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 0;
        background: linear-gradient(180deg, #0070f3 0%, #00d4ff 100%);
        transition: height 0.4s ease;
    }
    .nav-dot.active::after { height: 100%; }

    .nav-dot.thumb {
        width: 54px;
        height: 34px;
        border-radius: 6px;
        overflow: hidden;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .nav-dot.thumb img { width:100%; height:100%; object-fit:cover; opacity: .9; }
    .nav-dot.thumb.active { transform: scale(1.04); box-shadow: 0 8px 22px rgba(37,99,235,0.1); border-color: rgba(255,255,255,0.18); }

    .carousel-controls {
        position: absolute;
        bottom: 20px;
        left: 80px;
        display: flex;
        gap: 20px;
        z-index: 100;
    }
    .control-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
        backdrop-filter: blur(6px);
    }
    .control-btn:hover {
        transform: translateY(-4px) scale(1.04);
        box-shadow: 0 10px 30px rgba(37,99,235,0.12);
        background: rgba(255,255,255,0.12);
    }
    .control-btn::after {
        content: '';
        width: 12px;
        height: 12px;
        border-top: 2px solid #ffffff;
        border-right: 2px solid #ffffff;
    }
    .prev-btn::after { transform: rotate(-135deg); }
    .next-btn::after { transform: rotate(45deg); }

    .slide-indicator {
        position: absolute;
        bottom: 80px;
        right: 80px;
        font-size: 0.8rem;
        color: #555555;
        font-weight: 400;
        z-index: 100;
        letter-spacing: 1px;
    }
    .current-slide { color: #ffffff; font-weight: 600; }

    /* subtle fade/slide-up used for text */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(8px) scale(.995); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Parallax helper */
    .parallax-bg { will-change: transform; transition: transform 0.15s linear; }

    /* Mobile / responsive adjustments */
    @media (max-width: 1024px) {
        .carousel-slide { grid-template-columns: 1fr; grid-template-rows: 2fr 1fr; }
        .slide-content { padding: 40px; order: 2; max-width: 100%; }
        .slide-image { order: 1; }
        .slide-cta { width: 60%;}
        .slide-title { font-size: 2.4rem; }
        .carousel-controls { right: 40px; left: auto; bottom: 40px; }
        .carousel-nav { bottom: 40px; right: 40px; }
        .carousel-nav.horizontal { bottom: 40px; }
    }

    @media (max-width: 768px) {
        .slide-content { padding: 24px; }
        .slide-title { font-size: 1.9rem; line-height: 1.05; }
        .slide-description { font-size: 1rem; }
        .slide-cta { display: block; width: 100%; text-align: center; padding: 0.95rem; font-size: 1rem; }
        .nav-dot { width: 6px; height: 30px; }
        .nav-dot.thumb { width: 48px; height: 30px; }
        .carousel-controls, .slide-indicator { bottom: 20px; left: 20px; }
        .slide-indicator { right: 20px; left: auto; }
    }

    /* accessibility focus */
    .control-btn:focus, .nav-dot:focus, .slide-cta:focus {
        outline: 3px solid rgba(37,99,235,0.18);
        outline-offset: 4px;
    }
