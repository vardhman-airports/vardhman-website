<!-- Mobile tap-to-reveal + dismiss by tapping the dim -->
<script>
    document.querySelectorAll('.team-card').forEach(function(card) {
        card.addEventListener('click', function(e) {
            if (window.matchMedia('(hover: none)').matches) {
                e.stopPropagation();
                var isOpen = card.classList.contains('tapped');
                document.querySelectorAll('.team-card.tapped').forEach(function(c) {
                    c.classList.remove('tapped');
                });
                if (!isOpen) card.classList.add('tapped');
            }
        });
    });

    // Tapping the dim overlay closes any open card
    document.body.addEventListener('click', function() {
        if (window.matchMedia('(hover: none)').matches) {
            document.querySelectorAll('.team-card.tapped').forEach(function(c) {
                c.classList.remove('tapped');
            });
        }
    });
</script>

