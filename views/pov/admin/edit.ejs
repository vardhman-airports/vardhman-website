<%- include('../../partials/header') %>
<br><br><br><br><br>
<link rel="stylesheet" href="/css/admin.css">

<div class="admin-container">
        <div class="admin-header">
            <h1>Edit Post</h1>
            <a href="/pov/admin" class="btn-secondary">Back to Dashboard</a>
        </div>
        
        <div class="admin-content">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            
            <form method="POST" action="/pov/admin/edit/<%= post.id %>" enctype="multipart/form-data" class="post-form">
                <div class="form-group">
                    <label for="type">Type:</label>
                    <select id="type" name="type" required>
                        <option value="catalogue" <%= (post.type === 'catalogue' || !post.type) ? 'selected' : '' %>>Catalogue</option>
                        <option value="blog" <%= post.type === 'blog' ? 'selected' : '' %>>Blog</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" value="<%= post.title %>" required>
                </div>
                
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" rows="3" required><%= post.description %></textarea>
                </div>
                
                <div class="form-group">
                    <label for="author">Author:</label>
                    <input type="text" id="author" name="author" value="<%= post.author %>" required>
                </div>
                
                <div class="form-group">
                    <label for="content">Content:</label>
                    <textarea id="content" name="content" rows="10" required><%= post.content %></textarea>
                </div>
                
                <div class="form-group">
                    <label for="pdf">PDF File:</label>
                    <% if (post.pdf_file) { %>
                        <p style="margin: 0 0 0.4rem;">Current PDF: <%= post.pdf_file %></p>
                        <label style="font-weight: 400; display: block; margin-bottom: 0.5rem;">
                            <input type="checkbox" name="removePdf"> Remove current PDF
                        </label>
                    <% } %>
                    <input type="file" id="pdf" name="pdf" accept=".pdf">
                    <small>Leave empty to keep current PDF. Uploading a new file replaces it; check "Remove" to delete it.</small>
                </div>
                
                <button type="submit" class="btn-primary">Update Post</button>
            </form>
        </div>
    </div>


<%- include('../../partials/footer') %>