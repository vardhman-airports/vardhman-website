<%- include('../partials/header',{currentTitle: 'Downloads' }) %>

    <link rel="stylesheet" href="/css/pov.css">
    <br><br><br>
    <div class="top-br">
        <br>
        <br>
    </div>

    <style>
      /* Tab navigation */
      .downloads-tabs-wrapper {
        background: #fff;
        border-bottom: 2px solid #e5e7eb;
        position: sticky;
        top: 72px;
        z-index: 50;
      }
      .downloads-tabs {
        display: flex;
        max-width: 900px;
        margin: 0 auto;
        gap: 0;
      }
      .tab-btn {
        flex: 1;
        padding: 1.1rem 1.5rem;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        font-family: "Montserrat", "Poppins", Arial, sans-serif;
        font-weight: 600;
        font-size: 1rem;
        color: #6b7280;
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .tab-btn.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
      }
      .tab-btn:hover:not(.active) {
        color: #1e293b;
        border-bottom-color: #cbd5e1;
      }

      /* Tab content panels */
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      /* Blogs / News empty state */
      .empty-section {
        padding: 6rem 2rem;
        text-align: center;
        min-height: 50vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom right, #f3f4f6, #e5e7eb);
      }
      .empty-section .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.35;
      }
      .empty-section h3 {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 1.6rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
      }
      .empty-section p {
        color: #6b7280;
        font-size: 1rem;
        max-width: 420px;
      }

      /* News tab (LinkedIn embed) */
      .news-section-wrap {
        padding: 3rem 0 4rem;
        min-height: 60vh;
        background: linear-gradient(to bottom right, #f3f4f6, #e5e7eb);
      }
      .news-section-wrap h1 {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 700;
        text-align: center;
        color: #1e293b;
        margin-bottom: 2rem;
      }
      .sk-posts-header {
        visibility: hidden !important;
        position: absolute !important;
      }
      .sk-post-footer {
        visibility: hidden !important;
        position: absolute !important;
      }
      .sk-posts-body {
        padding: 0 5rem;
      }
      @media (max-width: 768px) {
        .catalogues-section .container-fluid { padding: 0 1.5rem; }
        .cat-grid { grid-template-columns: 1fr 1fr; }
        .sk-posts-body { padding: 0 1rem !important; }
        .downloads-tabs-wrapper { top: 58px; }
      }
      @media (max-width: 480px) {
        .cat-grid { grid-template-columns: 1fr; }
      }

      .elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb
        a[href*="elfsight.com/linkedin-feed-widget"] {
        position: absolute !important;
        left: -9999px !important;
        width: 0 !important; height: 0 !important;
        overflow: hidden !important; opacity: 0 !important;
        visibility: hidden !important; pointer-events: none !important;
        font-size: 0 !important; line-height: 0 !important;
      }
    </style>

    <!-- Tab navigation -->
    <div class="downloads-tabs-wrapper">
      <div class="downloads-tabs">
        <button class="tab-btn active" data-tab="catalogues">Catalogues</button>
        <button class="tab-btn" data-tab="blogs">Blogs</button>
        <button class="tab-btn" data-tab="news">News</button>
      </div>
    </div>

    <!-- ======================== CATALOGUES TAB ======================== -->
    <div id="tab-catalogues" class="tab-panel active">
      <section id="pov-grid">
        <div class="container-fluid">
          <h1 class="heading">Catalogues</h1>
          <div class="pov-grid">
            <% if (povPosts.length === 0) { %>
              <div class="no-posts">
                <p>No catalogues available at the moment.</p>
              </div>
            <% } else { %>
              <% povPosts.forEach(post => { %>
                <div class="modern-card">
                  <div class="modern-card-content">
                    <div>
                      <h3 class="modern-card-title"><%= post.title %></h3>
                      <p class="modern-card-description">
                        <% if (post.description) { %>
                          <%= post.description.substring(0, 300) %><% if (post.description.length > 300) { %>...<% } %>
                        <% } else { %>
                          <%= post.content.substring(0, 300) %><% if (post.content.length > 300) { %>...<% } %>
                        <% } %>
                      </p>
                    </div>
                    <div>
                      <div class="modern-card-meta">
                        <span class="author">By <%= post.author %></span>
                        <span class="date"><%= new Date(post.created_at_display).toLocaleDateString() %></span>
                      </div>
                      <div class="modern-card-actions">
                        <button class="modern-card-button view-btn" onclick="showPost('<%= post.id %>')">View Details</button>
                        <% if (post.has_pdf) { %>
                          <a href="/pov/download/<%= post.id %>" class="modern-card-button download-btn">Download PDF</a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </section>
    </div>

    <!-- ======================== BLOGS TAB ======================== -->
    <div id="tab-blogs" class="tab-panel">
      <div class="empty-section">
        <div class="empty-icon"><i class="fas fa-pen-nib"></i></div>
        <h3>Blogs Coming Soon</h3>
        <p>We are working on insightful articles and industry updates. Check back soon.</p>
      </div>
    </div>

    <!-- ======================== NEWS TAB ======================== -->
    <div id="tab-news" class="tab-panel">
      <div class="news-section-wrap">
        <h1>Latest News &amp; Updates</h1>
        <script src="https://elfsightcdn.com/platform.js" async></script>
        <div class="elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb" data-elfsight-app-lazy></div>
        <script>
        (function () {
          const HIDE = 'position:absolute!important;left:-9999px!important;top:auto!important;' +
                       'width:0!important;height:0!important;overflow:hidden!important;' +
                       'opacity:0!important;visibility:hidden!important;font-size:0!important;' +
                       'line-height:0!important;pointer-events:none!important;color:transparent!important;';
          function clearBadge() {
            document.querySelectorAll(
              '.elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb a[href*="elfsight.com"]'
            ).forEach(function (el) {
              el.textContent = '';
              el.setAttribute('style', HIDE);
            });
          }
          var observer = new MutationObserver(clearBadge);
          function startObserver() {
            observer.observe(document.body, { childList: true, subtree: true });
            setTimeout(function () { observer.disconnect(); }, 15000);
          }
          if (document.body) { startObserver(); }
          else { document.addEventListener('DOMContentLoaded', startObserver); }
        })();
        </script>
      </div>
    </div>

    <!-- Modal for post details -->
    <div id="postModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="modalContent"></div>
        </div>
    </div>

    <script src="/js/pov.js"></script>

    <!-- Tab switching script -->
    <script>
      document.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = btn.getAttribute('data-tab');
          document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
          document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          document.getElementById('tab-' + target).classList.add('active');
          // Support URL hash for direct linking
          history.replaceState(null, '', '#' + target);
        });
      });

      // Activate tab from URL hash on load
      (function() {
        var hash = window.location.hash.replace('#', '');
        if (hash && document.getElementById('tab-' + hash)) {
          document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
          document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
          document.querySelector('[data-tab="' + hash + '"]').classList.add('active');
          document.getElementById('tab-' + hash).classList.add('active');
        }
      })();
    </script>

    <%- include('../partials/footer') %>
