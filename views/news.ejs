    <!-- Elfsight LinkedIn Feed | Untitled LinkedIn Feed -->
    <script src="https://elfsightcdn.com/platform.js" async></script>
    <div class="elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb" data-elfsight-app-lazy></div>

    <style>
        .fHXPoA {
            padding: 0 1rem;
        }
/* Keep the link for Elfsight's JS, but make it fully invisible */
.elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb 
  a[href*="elfsight.com/linkedin-feed-widget"] {
  position: absolute !important;
  left: -9999px !important; /* move it off-screen */
  top: auto !important;
  width: 0 !important;
  height: 0 !important;
  overflow: hidden !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  color: transparent !important;
  background: none !important;
  border: none !important;
  font-size: 0 !important;
  line-height: 0 !important;
  z-index: -9999 !important;
}
</style>

<script>
(function () {
  const HIDE = 'position:absolute!important;left:-9999px!important;top:auto!important;' +
               'width:0!important;height:0!important;overflow:hidden!important;' +
               'opacity:0!important;visibility:hidden!important;font-size:0!important;' +
               'line-height:0!important;pointer-events:none!important;color:transparent!important;';

  function clearBadge() {
    document.querySelectorAll(
      '.elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb a[href*="elfsight.com"]'
    ).forEach(function (el) {
      el.textContent = '';
      el.setAttribute('style', HIDE);
    });
  }

  // Watch for the badge being injected and kill it immediately
  var observer = new MutationObserver(clearBadge);

  function startObserver() {
    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(function () { observer.disconnect(); }, 15000);
  }

  if (document.body) {
    startObserver();
  } else {
    document.addEventListener('DOMContentLoaded', startObserver);
  }
})();
</script>




