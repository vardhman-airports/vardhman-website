    <style>
        .fHXPoA {
            padding: 0 1rem;
        }
/* Keep the link for Elfsight's JS, but make it fully invisible */
.elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb 
  a[href*="elfsight.com/linkedin-feed-widget"] {
  position: absolute !important;
  left: -9999px !important; /* move it off-screen */
  top: auto !important;
  width: 0 !important;
  height: 0 !important;
  overflow: hidden !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  color: transparent !important;
  background: none !important;
  border: none !important;
  font-size: 0 !important;
  line-height: 0 !important;
  z-index: -9999 !important;
}
</style>

<script>
window.addEventListener("load", () => {
  // Function to keep the badge invisible & textless
  const clearBadge = () => {
    const badge = document.querySelector(
      '.elfsight-app-a3d0f109-a7bf-450e-a2f0-c4c8d52375bb a[href*="elfsight.com/linkedin-feed-widget"]'
    );
    if (badge) {
      badge.textContent = ""; // remove text nodes like "ked"
      badge.innerHTML = "";   // remove any leftover children
      badge.style.setProperty("left", "-9999px", "important");
      badge.style.setProperty("opacity", "0", "important");
    }
  };

  // Run immediately and repeatedly to handle re-injections
  clearBadge();
  const interval = setInterval(clearBadge, 1000);

  // Optional: stop after 10s to save resources
  setTimeout(() => clearInterval(interval), 10000);
});
</script>




